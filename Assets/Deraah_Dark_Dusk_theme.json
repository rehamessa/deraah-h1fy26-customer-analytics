        "dropShadow": [{ "show": false }],
        "labels":     [{ "color": { "solid": { "color": "#FFF4E6" } }, "fontSize": 9 }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#B9B5C9" } }, "fontSize": 9, "gridlineShow": false }],
        "valueAxis":    [{ "labelColor": { "solid": { "color": "#B9B5C9" } }, "fontSize": 9, "gridlineColor": { "solid": { "color": "#2F3866" } } }],
        "legend":       [{ "labelColor": { "solid": { "color": "#B9B5C9" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#141A33" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#0E1226" } } }]
      }
    }
